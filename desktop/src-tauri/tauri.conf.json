{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Insurance AI",
  "version": "0.1.0",
  "identifier": "com.abc.insurance-ai",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/<owner>/<repo>/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDM4RjFDQThBNTI2NjYyNjkKUldScFltWlNpc3J4T0MrYU1yZjdTcnRHdHBMdEFZckdzNXYwelNVdUhYaHEwOWVic21jNGJnSGUK"
    }
  },
  "app": {
    "windows": [
      {
        "title": "Insurance AI",
        "width": 1000,
        "height": 720,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
