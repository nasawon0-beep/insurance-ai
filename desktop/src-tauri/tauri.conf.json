{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Insurance AI",
  "mainBinaryName": "Insurance AI",
  "version": "2.5.5",
  "identifier": "com.abc.insurance-ai",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://nasawon0-beep.github.io/insurance-ai-updates/api/windows-latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDk0QTI3NjMwREI4NzkyRTQKUldUa2tvZmJNSGFpbEVvRHFjSkluOWpNc3BGTGRVODllcERZTlVmVmNPeEtjSHlHcDlkUlE2dEQK",
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "app": {
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "externalBin": [
      "binaries/control-server",
      "binaries/local-engine"
    ],
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "wix": {
        "language": "ko-KR"
      },
      "nsis": {
        "languages": [
          "Korean"
        ],
        "displayLanguageSelector": false
      }
    }
  }
}
