# 이 파일을 secrets.env 로 복사해 사용하세요. secrets.env 는 이 PC 전용이며 커밋·공유하지 마세요.
# JWT 서명 키. 프로덕션에서는 설치마다 유니크한 강한 랜덤 값으로 교체하세요.
CONTROL_JWT_SECRET=replace-with-a-unique-strong-random-secret
# 관리 API 인증 토큰. 프로덕션에서는 설치마다 유니크한 강한 랜덤 값으로 교체하세요.
CONTROL_ADMIN_TOKEN=replace-with-a-unique-strong-random-token
# 오프라인 라이선스 서명 키. 프로덕션에서도 데스크톱 빌드의 VITE_LICENSE_SECRET 과 반드시 동일하게 교체하세요.
CONTROL_LICENSE_SECRET=dev-license-secret-change-me
# 로컬 파일럿은 start 스크립트가 실행 시 자동으로 1 설정합니다. 공유·호스팅 서버에서는 절대 1로 두지 마세요 (무인증 계정 복구·이메일 열거).
CONTROL_LOCAL_RECOVERY=0
